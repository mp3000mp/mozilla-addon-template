{
  "manifest_version": 3,
  "name": "MP3000",
  "version": "1.0.1",
  "description": "Test",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mp3000@mp3000.fr",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.ts"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
